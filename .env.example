# Database and authentication
MONGO_URI=mongodb://127.0.0.1:27017/agency-dashboard
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Browser Web Push
# Generate one matching pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_SUBJECT=mailto:notifications@example.com

# Deployment origins
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
PORT=8080

# Existing optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FIREBASE_SERVICE_ACCOUNT=

# Incoming Project Request
# Ring/vibrate cutoff (the assignment itself remains pending after this time).
PROJECT_ASSIGNMENT_ALERT_TIMEOUT_SECONDS=120
# Durable data-message delivery window for temporarily offline Android devices.
PROJECT_ASSIGNMENT_FCM_TTL_SECONDS=604800
